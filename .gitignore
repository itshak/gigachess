# Clean-room wall — GPL-tainted refs are spec-agent only and never enter impl history
# Ignore clones under refs/gpl-only/, but keep the README documenting the taint
refs/gpl-only/*
!refs/gpl-only/README.md

# ReScript build cache (in-source .bs.js is committed, lib/ is not)
lib/bs/
lib/ocaml/

# Tauri bundled engine — generated by src-tauri/build.rs
src-tauri/resources/engines_selected/stockfish
src-tauri/resources/engines_selected/stockfish.exe
