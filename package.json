{
  "name": "purechess-workstation",
  "version": "0.1.0",
  "description": "PureChess — native, local-first, accessible chess workstation (AGPL-3.0-or-later). Baseline for MIT purechess library.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./pgn": {
      "types": "./dist/pgn.d.ts",
      "import": "./dist/pgn.js"
    },
    "./chess960": {
      "types": "./dist/chess960.d.ts",
      "import": "./dist/chess960.js"
    },
    "./chessops": {
      "types": "./dist/chessops.d.ts",
      "import": "./dist/chessops.js"
    },
    "./chessjs": {
      "types": "./dist/chessjs.d.ts",
      "import": "./dist/chessjs.js"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node tests/perft.mjs && node tests/parity.mjs && node tests/purity.mjs",
    "bench": "node bench/bench-sliding.mjs --iters 1000000 && node bench/bench-perft.mjs --depth 5 && node bench/bench-pgn.mjs --games 1000 && node bench/bench-fen-san.mjs --iters 1000 && node bench/bench-bundle.mjs --entry core",
    "bench:sliding": "node bench/bench-sliding.mjs",
    "bench:perft": "node bench/bench-perft.mjs",
    "bench:pgn": "node bench/bench-pgn.mjs",
    "bench:fen-san": "node bench/bench-fen-san.mjs",
    "bench:bundle": "node bench/bench-bundle.mjs",
    "bench:ci": "node bench/bench-ci.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test:parity": "npm run build && node tests/parity.mjs",
    "test:perft": "npm run build && node tests/perft.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "chessops": "0.15.1",
    "esbuild": "^0.25.0",
    "rescript": "^12.3.1",
    "typescript": "^5.7.0"
  }
}
