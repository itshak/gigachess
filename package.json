{
  "name": "turbochess",
  "version": "0.2.0",
  "description": "turbochess \u2014 fast, clean-room, MIT-licensed chess engine library (functional public API, imperative inside). Formerly published as purechess (alias kept for one release).",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./pgn": {
      "types": "./dist/pgn.d.ts",
      "import": "./dist/pgn.js"
    },
    "./chess960": {
      "types": "./dist/chess960.d.ts",
      "import": "./dist/chess960.js"
    },
    "./chessops": {
      "types": "./dist/chessops/index.d.ts",
      "import": "./dist/chessops/index.js"
    },
    "./chessjs": {
      "types": "./dist/chessjs.d.ts",
      "import": "./dist/chessjs.js"
    },
    "./chessops/board": {
      "types": "./dist/chessops/board.d.ts",
      "import": "./dist/chessops/board.js"
    },
    "./chessops/chess": {
      "types": "./dist/chessops/chess.d.ts",
      "import": "./dist/chessops/chess.js"
    },
    "./chessops/debug": {
      "types": "./dist/chessops/debug.d.ts",
      "import": "./dist/chessops/debug.js"
    },
    "./chessops/fen": {
      "types": "./dist/chessops/fen.d.ts",
      "import": "./dist/chessops/fen.js"
    },
    "./chessops/san": {
      "types": "./dist/chessops/san.d.ts",
      "import": "./dist/chessops/san.js"
    },
    "./chessops/setup": {
      "types": "./dist/chessops/setup.d.ts",
      "import": "./dist/chessops/setup.js"
    },
    "./chessops/squareSet": {
      "types": "./dist/chessops/squareSet.d.ts",
      "import": "./dist/chessops/squareSet.js"
    },
    "./chessops/types": {
      "types": "./dist/chessops/types.d.ts",
      "import": "./dist/chessops/types.js"
    },
    "./chessops/util": {
      "types": "./dist/chessops/util.d.ts",
      "import": "./dist/chessops/util.js"
    },
    "./chesstree": {
      "types": "./dist/chesstree.d.ts",
      "import": "./dist/chesstree.js"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node tests/perft.mjs && node tests/castling.mjs && node tests/parity.mjs && node tests/purity.mjs && node tests/compat-chessops.mjs && node tests/chessjs-parity.mjs && node tests/chesstree-parity.mjs",
    "bench": "node bench/bench-sliding.mjs --iters 1000000 && node bench/bench-perft.mjs --depth 5 && node bench/bench-pgn.mjs --games 1000 && node bench/bench-fen-san.mjs --iters 1000 && node bench/bench-bundle.mjs --entry core",
    "bench:sliding": "node bench/bench-sliding.mjs",
    "bench:perft": "node bench/bench-perft.mjs",
    "bench:pgn": "node bench/bench-pgn.mjs",
    "bench:fen-san": "node bench/bench-fen-san.mjs",
    "bench:bundle": "node bench/bench-bundle.mjs",
    "bench:ci": "node bench/bench-ci.mjs",
    "bench:real": "node --expose-gc bench/bench-real.mjs",
    "bench:real:ci": "node --expose-gc bench/bench-real.mjs --ci",
    "build": "tsc -p tsconfig.build.json",
    "test:parity": "npm run build && node tests/parity.mjs",
    "test:perft": "npm run build && node tests/perft.mjs"
  },
  "devDependencies": {
    "@itshak/chesstree": "^2.0.0",
    "@types/node": "^26.4.0",
    "chess.js": "^1.4.0",
    "chessops": "0.15.1",
    "esbuild": "^0.25.0",
    "rescript": "^12.3.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@badrap/result": "0.3.1"
  }
}
